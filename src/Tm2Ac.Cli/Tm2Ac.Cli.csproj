<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tm2ac</AssemblyName>
  </PropertyGroup>

  <!-- Release build: dotnet publish src/Tm2Ac.Cli -c Release -r win-x64 (single self-contained exe). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Keep the release folder to the exe: SkiaSharp alone ships a ~96 MB native .pdb. -->
  <Target Name="RemoveNativePdbsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedPdbs Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedPdbs)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Tm2Ac.Core\Tm2Ac.Core.csproj" />
    <ProjectReference Include="..\Tm2Ac.Tmx\Tm2Ac.Tmx.csproj" />
    <ProjectReference Include="..\Tm2Ac.Gbx\Tm2Ac.Gbx.csproj" />
    <ProjectReference Include="..\Tm2Ac.Assets\Tm2Ac.Assets.csproj" />
    <ProjectReference Include="..\Tm2Ac.Geometry\Tm2Ac.Geometry.csproj" />
    <ProjectReference Include="..\Tm2Ac.Kn5\Tm2Ac.Kn5.csproj" />
    <ProjectReference Include="..\Tm2Ac.AcTrack\Tm2Ac.AcTrack.csproj" />
    <ProjectReference Include="..\Tm2Ac.Pipeline\Tm2Ac.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
