<UserControl x:Class="Tm2Ac.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Heading}" />

            <TextBlock Text="ASSETTO CORSA" Style="{StaticResource Label}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseAcCommand}" />
                <TextBox Text="{Binding AcPath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Text="Leave empty to find it through Steam automatically." Style="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0" />
            <TextBlock Text="{Binding AcStatus}" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CspStatus}" Margin="0,2,0,0" TextWrapping="Wrap" />

            <TextBlock Text="TRACKMANIA NATIONS FOREVER" Style="{StaticResource Label}" Margin="0,18,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseTmnfCommand}" />
                <TextBox Text="{Binding TmnfPath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Text="Block meshes and textures are read from this install. Leave empty to auto-detect." Style="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0" />
            <TextBlock Text="{Binding TmnfStatus}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <TextBlock Text="CONVERSION DEFAULTS" Style="{StaticResource Label}" Margin="0,18,0,4" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Scale" Width="110" VerticalAlignment="Center" />
                <TextBox Width="60" Text="{Binding DefaultScale, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="0.25–4 (1.5 road cars, 2 GT, 2.5 formula)" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Starting spots" Width="110" VerticalAlignment="Center" />
                <TextBox Width="60" Text="{Binding DefaultPitboxes, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <CheckBox Margin="0,8,0,0" IsChecked="{Binding DefaultGrass}" Content="Fill empty ground with Stadium grass" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Save" Command="{Binding SaveCommand}" Padding="18,6" />
                <Button Margin="8,0,0,0" Content="Re-check" Command="{Binding RefreshCommand}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="CACHE" Style="{StaticResource Label}" Margin="0,24,0,4" />
            <TextBlock Text="{Binding CacheStatus}" TextWrapping="Wrap" />
            <TextBlock Text="Downloaded maps, replays and images. Safe to clear." Style="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Clear cache" Command="{Binding ClearCacheCommand}" />
                <Button Margin="8,0,0,0" Content="Open logs" Command="{Binding OpenLogsCommand}" />
            </StackPanel>

            <TextBlock Text="LEGAL" Style="{StaticResource Label}" Margin="0,24,0,4" />
            <TextBlock Text="{Binding Legal, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource Dim}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
