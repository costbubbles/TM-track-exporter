<UserControl x:Class="Tm2Ac.App.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Tm2Ac.App.ViewModels">
    <UserControl.Resources>
        <!-- Selected track: details, options, Convert & Install. -->
        <DataTemplate DataType="{x:Type vm:TrackDetailViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,24">
                    <Border Background="{StaticResource Panel}" CornerRadius="4" HorizontalAlignment="Left" MaxHeight="220">
                        <Image Source="{Binding Screenshot}" Stretch="Uniform" />
                    </Border>

                    <TextBlock Text="{Binding Item.Name}" Style="{StaticResource Heading}" Margin="0,16,0,2" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="by " Style="{StaticResource Dim}" />
                        <TextBlock Text="{Binding Item.Author}" />
                        <Button Style="{StaticResource LinkButton}" Margin="14,0,0,0" Command="{Binding OpenOnTmxCommand}" Content="Open on TMX ↗" />
                    </StackPanel>
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Dim}" Margin="0,6,0,8" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Item.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Tag}">
                                    <TextBlock Text="{Binding}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,4" />

                    <TextBlock Text="SCALE" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding ScalePresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="ScalePresets"
                                                 Command="{Binding DataContext.SetScaleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 CommandParameter="{Binding}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource NumbersEqual}" Mode="OneWay">
                                                <Binding Path="DataContext.Scale" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                <Binding Path="Scale" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                        <TextBlock>
                                            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Scale, Mode=OneWay, StringFormat={}{0:0.0}×}" />
                                        </TextBlock>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Width="56" Margin="8,0,0,0" Text="{Binding ScaleText, UpdateSourceTrigger=LostFocus}" ToolTip="Custom scale, 0.25–4" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Trackmania cars are very fast. A bigger scale makes corners and jumps fit slower AC cars." />

                    <TextBlock Text="STARTING SPOTS" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="56" Text="{Binding Pitboxes, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="1 = everyone starts on the start line; more adds a grid behind it" />
                    </StackPanel>

                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding DefaultGrass}" Content="Fill empty ground with Stadium grass" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource AccentButton}" Padding="18,8" Command="{Binding ConvertCommand}" Content="Convert &amp; Install" />
                        <Button Margin="8,0,0,0" Command="{Binding ConvertCancelCommand}" Content="Cancel"
                                Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Warn}" Text="Only Stadium tracks can be converted for now.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Item.IsConvertible}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Log}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}• {0}}" Style="{StaticResource Dim}" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold"
                               Visibility="{Binding Result, Converter={StaticResource HasValue}}" />
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Content="Open track folder ↗"
                            Command="{Binding OpenFolderCommand}" Visibility="{Binding InstalledPath, Converter={StaticResource HasValue}}" />

                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" MaxWidth="760" HorizontalAlignment="Left"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                                    <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding Description, Converter={StaticResource HasValue}}">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,4" />
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource Dim}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <WrapPanel>
                <StackPanel Margin="0,0,16,6">
                    <TextBlock Text="SOURCE" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Chip}" GroupName="Game" Content="TMNF-X"
                                     IsChecked="{Binding Game, Converter={StaticResource Equals}, ConverterParameter=Tmnf}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="Game" Content="TMUF-X"
                                     IsChecked="{Binding Game, Converter={StaticResource Equals}, ConverterParameter=Tmuf}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="NAME" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <TextBox Width="170" Text="{Binding Name}" KeyDown="OnSearchKeyDown" />
                </StackPanel>
                <StackPanel Margin="0,0,16,6">
                    <TextBlock Text="AUTHOR" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <TextBox Width="120" Text="{Binding Author}" KeyDown="OnSearchKeyDown" />
                </StackPanel>
                <StackPanel Margin="0,0,16,6">
                    <TextBlock Text="TYPE" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Chip}" GroupName="Type" Content="Any"
                                     IsChecked="{Binding PrimaryType, Converter={StaticResource Equals}, ConverterParameter=''}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="Type" Content="Race"
                                     IsChecked="{Binding PrimaryType, Converter={StaticResource Equals}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="Type" Content="Laps"
                                     IsChecked="{Binding PrimaryType, Converter={StaticResource Equals}, ConverterParameter=5}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,16,6">
                    <TextBlock Text="SORT" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Chip}" GroupName="Order" Content="Most awards"
                                     IsChecked="{Binding Order, Converter={StaticResource Equals}, ConverterParameter=MostAwards}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="Order" Content="Newest"
                                     IsChecked="{Binding Order, Converter={StaticResource Equals}, ConverterParameter=Newest}" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="Order" Content="Recent activity"
                                     IsChecked="{Binding Order, Converter={StaticResource Equals}, ConverterParameter=MostRecentActivity}" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Margin="0,0,0,6" Command="{Binding SearchCommand}" Content="Search" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Results -->
            <DockPanel Margin="12,10,6,10">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,8,0,0">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                    <Button Margin="12,0,0,0" Content="Load more" Command="{Binding LoadMoreCommand}"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedTrack}"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TrackItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Width="112" Height="63" Background="{StaticResource Panel}" CornerRadius="3" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Author}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Style="{StaticResource Dim}" FontSize="11">
                                            <Run Text="★" Foreground="{StaticResource Accent}" /><Run Text="{Binding Awards, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Type, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding AuthorTime, Mode=OneWay}" />
                                        </TextBlock>
                                        <Border Style="{StaticResource Tag}" Background="{StaticResource Ok}" Margin="8,0,0,0"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Installed" FontSize="10" Foreground="{StaticResource AccentText}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Detail -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Grid>
                    <TextBlock Text="Select a track to see its details and convert it." Style="{StaticResource Dim}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Detail, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    <ContentControl Content="{Binding Detail}" Focusable="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
